@{
    ViewData["Title"] = "Skills";
}

<div class="container my-4">
    <h2 class="fw-bold mb-4 text-dark"><i class="bi bi-cpu text-primary me-2"></i>Technical Capabilities</h2>
    <div class="row g-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-white p-2">
                <div class="card-body text-center">
                    <i class="bi bi-code-square display-5 text-primary mb-3"></i>
                    <h5 class="card-title fw-bold">Programming</h5>
                    <ul class="list-unstyled mt-3 mb-0 text-secondary">
                        <li class="py-1 border-bottom">C#</li>
                        <li class="py-1 border-bottom">JavaScript</li>
                        <li class="py-1 border-bottom">Python</li>
                        <li class="py-1">SQL</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-white p-2">
                <div class="card-body text-center">
                    <i class="bi bi-globe display-5 text-success mb-3"></i>
                    <h5 class="card-title fw-bold">Web Technologies</h5>
                    <ul class="list-unstyled mt-3 mb-0 text-secondary">
                        <li class="py-1 border-bottom">ASP.NET Core MVC</li>
                        <li class="py-1 border-bottom">HTML5 & CSS3</li>
                        <li class="py-1 border-bottom">Bootstrap 5</li>
                        <li class="py-1">RESTful APIs</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-white p-2">
                <div class="card-body text-center">
                    <i class="bi bi-database display-5 text-warning mb-3"></i>
                    <h5 class="card-title fw-bold">Databases</h5>
                    <ul class="list-unstyled mt-3 mb-0 text-secondary">
                        <li class="py-1 border-bottom">SQL Server</li>
                        <li class="py-1 border-bottom">MySQL</li>
                        <li class="py-1 border-bottom">Entity Framework</li>
                        <li class="py-1">SQLite</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm bg-white p-2">
                <div class="card-body text-center">
                    <i class="bi bi-tools display-5 text-info mb-3"></i>
                    <h5 class="card-title fw-bold">Tools & Platforms</h5>
                    <ul class="list-unstyled mt-3 mb-0 text-secondary">
                        <li class="py-1 border-bottom">Visual Studio 2022</li>
                        <li class="py-1 border-bottom">Git & GitHub</li>
                        <li class="py-1 border-bottom">Cisco Packet Tracer</li>
                        <li class="py-1">Postman</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>