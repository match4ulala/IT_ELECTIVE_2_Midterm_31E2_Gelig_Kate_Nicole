@{
    ViewData["Title"] = "Home";
}

<div class="container my-5">
    <div class="row align-items-center gy-4 p-4 rounded-4 bg-white shadow-sm border border-0">
        <div class="col-md-4 text-center">
            <img src="~/images/Kate.jpeg" alt="Professional Photo" class="img-fluid rounded-circle shadow-lg border border-4 border-white" style="width: 220px; height: 220px; object-fit: cover;" />
        </div>
        <div class="col-md-8 text-center text-md-start">
            <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 mb-2 rounded-pill">Available for Projects</span>
            <h1 class="display-5 fw-bold text-dark mb-2">@ViewData["FullName"]</h1>
            <h4 class="text-muted fw-normal mb-3">@ViewData["ProfessionalTitle"]</h4>
            <p class="lead text-secondary mb-4">
                @ViewData["Introduction"]
            </p>
            <div class="d-flex gap-3 justify-content-center justify-content-md-start">
                <a asp-controller="Home" asp-action="Projects" class="btn btn-animated-primary btn-lg px-4">
                    <i class="bi bi-briefcase me-2"></i>Explore Projects
                </a>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-animated-outline btn-lg px-4">
                    <i class="bi bi-envelope me-2"></i>Get in Touch
                </a>
            </div>
        </div>
    </div>
</div>