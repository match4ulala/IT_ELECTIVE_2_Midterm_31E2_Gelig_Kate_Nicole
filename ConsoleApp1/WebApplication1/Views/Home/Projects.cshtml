@{
    ViewData["Title"] = "Projects";
}

<div class="container my-4">
    <h2 class="fw-bold mb-4 text-dark"><i class="bi bi-kanban text-primary me-2"></i>Featured Works</h2>
    <div class="row g-4">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm bg-white overflow-hidden">
                <img src="https://via.placeholder.com/400x225" class="card-img-top" alt="Inventory System">
                <div class="card-body d-flex flex-column p-4">
                    <h5 class="card-title fw-bold text-dark">Store & Inventory System</h5>
                    <p class="card-text text-secondary flex-grow-1">
                        A relational database application designed to manage multi-store transaction logs, units of measurement, and real-time inventory levels.
                    </p>
                    <p class="card-text mb-3"><small class="text-primary fw-bold">Stack:</small> <small class="text-muted">C#, SQL Server, ASP.NET Core</small></p>
                    <button type="button" class="btn btn-animated-outline w-100 mt-auto">
                        View Project <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm bg-white overflow-hidden">
                <img src="https://via.placeholder.com/400x225" class="card-img-top" alt="Network Topology Simulation">
                <div class="card-body d-flex flex-column p-4">
                    <h5 class="card-title fw-bold text-dark">Network Infrastructure Design</h5>
                    <p class="card-text text-secondary flex-grow-1">
                        A simulated network topology focusing on OSI model layer mapping, packet routing strategies, and network protocol security.
                    </p>
                    <p class="card-text mb-3"><small class="text-primary fw-bold">Stack:</small> <small class="text-muted">Cisco Packet Tracer, OSI/TCP-IP</small></p>
                    <button type="button" class="btn btn-animated-outline w-100 mt-auto">
                        View Details <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm bg-white overflow-hidden">
                <img src="https://via.placeholder.com/400x225" class="card-img-top" alt="Mobile App Data Sync">
                <div class="card-body d-flex flex-column p-4">
                    <h5 class="card-title fw-bold text-dark">Mobile Data Sync Engine</h5>
                    <p class="card-text text-secondary flex-grow-1">
                        A conceptual engine built to manage offline storage mechanisms, conflict resolution strategies, and automatic cloud synchronization.
                    </p>
                    <p class="card-text mb-3"><small class="text-primary fw-bold">Stack:</small> <small class="text-muted">JavaScript, REST API, SQLite</small></p>
                    <button type="button" class="btn btn-animated-outline w-100 mt-auto">
                        View Case Study <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>